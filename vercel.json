{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "geolocation=(self), camera=(self), publickey-credentials-get=(self), publickey-credentials-create=(self)" }] }
  ]
}
