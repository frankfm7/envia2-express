rules_version = '2';
// Reglas de seguridad de Envia2 Express. Pégalas en: Firebase → Firestore Database → Reglas → Publicar.
// IMPORTANTE: cambia tu_correo@gmail.com por el/los correos de administrador (igual que VITE_ADMIN_EMAILS).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['tu_correo@gmail.com']; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isDriver() { return signedIn() && profile().role == 'driver' && profile().approved == true; }
    function shipment(id) { return get(/databases/$(database)/documents/shipments/$(id)).data; }
    function involved(s) { return s.clientId == request.auth.uid || s.recipientUid == request.auth.uid || s.driverId == request.auth.uid; }
    // Lo que un CLIENTE puede cambiar de su envío: confirmar lugar/hora, calificar, cancelar,
    // pedir reenvío (el precio solo puede SUBIR) — nunca marcarlo entregado ni bajar el precio.
    function clientEdit() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['status', 'events', 'updatedAt', 'clientBiometric', 'rating', 'review', 'meeting', 'dropoff', 'tripRoute',
                           'scheduledAt', 'recipientPos', 'recipientStatus', 'receiptSent', 'route', 'price', 'redelivery', 'tariff',
                           'driverId', 'driverPos', 'pickupArrivedAt', 'nearNotified', 'claimKey', 'receiptRequestedAt'])
        && (!keys.hasAny(['price']) || request.resource.data.price >= resource.data.price)
        && (!keys.hasAny(['status']) || request.resource.data.status in ['cancelled', 'pending']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Todos se registran como CLIENTE (el administrador entra con su correo)
      allow create: if signedIn() && request.auth.uid == uid && (
        isAdmin() ||
        (request.resource.data.role == 'client' && request.resource.data.approved == true));
      allow update: if isAdmin()
        // El usuario edita su perfil, pero no puede cambiar su rol ni aprobarse solo.
        // Solo puede pasar su solicitud de repartidor a "pending".
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.approved == resource.data.approved
            && (request.resource.data.get('driverStatus', 'none') == resource.data.get('driverStatus', 'none')
                || request.resource.data.driverStatus == 'pending')
            && request.resource.data.get('authCode', null) == resource.data.get('authCode', null)
            // Repartidor: nombre, placa y vehículo son datos verificados (solo los cambia el administrador)
            && (resource.data.role != 'driver' || (request.resource.data.get('name', null) == resource.data.get('name', null)
                && request.resource.data.get('plate', null) == resource.data.get('plate', null)
                && request.resource.data.get('vehicle', null) == resource.data.get('vehicle', null))))
        // Activación de repartidor: solo con el código que generó el administrador
        || (request.auth.uid == uid
            && resource.data.get('driverStatus', 'none') == 'code_sent'
            && request.resource.data.role == 'driver'
            && request.resource.data.approved == true
            && request.resource.data.authCode == get(/databases/$(database)/documents/driverCodes/$(uid)).data.code
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'approved', 'authCode', 'driverStatus', 'online', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Solicitudes de repartidor (carnet, fotos, números de confianza): solo el dueño y el administrador
    match /driverApps/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending');
      // Solicitud nueva o corregida (rechazada): se puede reenviar completa como "pending".
      // Repartidor YA APROBADO: solo datos básicos; nombre, carnet, placa, vehículo, licencia y fotos quedan bloqueados.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && (
        (resource.data.status != 'approved' && (request.resource.data.status == 'pending' || request.resource.data.status == resource.data.status))
        || (resource.data.status == 'approved' && request.resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'homeAddress', 'brand', 'color', 'contacts', 'updatedAt']))));
      allow delete: if isAdmin();
    }

    // Códigos de ingreso de repartidores: SOLO el administrador
    match /driverCodes/{uid} {
      allow read, write: if isAdmin();
    }

    match /shipments/{id} {
      allow read: if isAdmin() || isDriver() || (signedIn() && involved(resource.data));
      allow create: if signedIn() && (isAdmin() || request.resource.data.clientId == request.auth.uid);
      allow update: if isAdmin() || isDriver() || (signedIn() && involved(resource.data) && clientEdit())
        // Vincular un envío con el enlace de WhatsApp (consultora / destinatario)
        || (signedIn() && resource.data.recipientUid == null
            && request.resource.data.recipientUid == request.auth.uid
            && request.resource.data.claimKey == resource.data.claimToken
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipientUid', 'claimKey', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Fotos y firmas (separadas para que la app cargue rápido)
    match /evidence/{id} {
      allow read, write: if isAdmin() || isDriver() || (signedIn() && involved(shipment(id)));
    }

    // Copia pública (seguimiento + comprobante) para clientes SIN la app.
    // Se lee solo con el enlace exacto (clave larga e imposible de adivinar); no se puede listar.
    match /public/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin() || isDriver();
    }

    // Ajustes del negocio (QR de cobro): todos los ven, solo el administrador los cambia
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Promociones: historial de puntos/cupones. Solo se agregan registros (no se borran ni editan)
    match /rewards/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // El cliente registra sus giros; el administrador además puede REGALAR (cupones, giros, puntos)
      allow create: if signedIn() && (isAdmin() || (request.resource.data.userId == request.auth.uid && request.resource.data.type == 'spin'));
      allow update, delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if signedIn() && request.resource.data.fromId == request.auth.uid && request.auth.uid in request.resource.data.participants;
    }

    match /notifications/{id} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
    }
  }
}
